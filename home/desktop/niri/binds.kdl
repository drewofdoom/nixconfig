// Niri binds configuration file

binds {
    // === Application Launchers ===
    Mod+Space hotkey-overlay-title="Launch: Application Launcher" {
      spawn "noctalia" "msg" "panel-toggle" "launcher";
    }
    Mod+Return hotkey-overlay-title="Launch: Terminal" {
      spawn "ghostty";
    }
    Mod+B hotkey-overlay-title="Launch: Zen Browser" {
      spawn "zen";
    }
    Mod+E hotkey-overlay-title="Launch: File Manager" {
      spawn "nautilus";
    }

    // === Noctalia ===
    Mod+N hotkey-overlay-title="Open Notepad" {
      spawn "noctalia" "msg" "panel-toggle" "noctalia/notes:panel";
    }
    Mod+Shift+N hotkey-overlay-title="Start Noctalia" {
      spawn "noctalia" "msg" "config-reload";
    }

    // === Actions ===
    Mod+D repeat=false { toggle-overview; }
    Mod+O repeat=false { toggle-overview; }
    Mod+C { center-column; }
    Mod+Shift+C { center-visible-columns; }
    Mod+Q repeat=false { close-window; }

    // === Focus ===
    // Direct workspace jumping
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Workspace directional navigation
    Mod+Page_Down { focus-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=250 { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+WheelScrollUp cooldown-ms=250 { focus-workspace-up; }

    // Window directional navigation
    Mod+Up { focus-window-or-monitor-up; }
    Mod+Down { focus-window-or-monitor-down; }
    Mod+Left { focus-column-or-monitor-left; }
    Mod+MouseBack { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+MouseForward { focus-column-or-monitor-right; }
    Mod+End { focus-column-last; }
    Mod+Home { focus-column-first; }
    Mod+WheelScrollLeft cooldown-ms=250 { focus-column-left; }
    Mod+WheelScrollRight cooldown-ms=250 { focus-column-right; }

    // === Move ===
    // Move to workspace directly
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Move to workspace by direction
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    // Vertical tiling
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    // Move window by direction
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }

    // Move column to monitor by direction
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // === Size ===
    Mod+F { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Alt+F { toggle-windowed-fullscreen; }
    Mod+M { maximize-window-to-edges; }
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { switch-preset-window-height; }

    // === Floating and Tabbed ===
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    // === Audio Controls ===
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioStop allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }

    // === Brightness Controls ===
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // === Power ===
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }
    Ctrl+Alt+Delete hotkey-overlay-title="Session Panel" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+L hotkey-overlay-title="Lock Session" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+Alt+L hotkey-overlay-title="Lock and Suspend" { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
    Mod+Shift+Alt+Escape { spawn "noctalia" "msg" "session" "shutdown"; }

    // === Screenshot ===
    Print hotkey-overlay-title="Screenshot: Area" { spawn "noctalia" "msg" "screenshot-region"; }
    Ctrl+Print hotkey-overlay-title="Screenshot: Screen" { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    // === Miscellaneous ===
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape hotkey-overlay-title="Toggle Keyboard Shortcuts Inhibit" { toggle-keyboard-shortcuts-inhibit; }
}
