! Minimal style for REAPER Fluxbox session — dark titlebars, high contrast
background: none
window.title.font: sans-serif:size=9
window.title.height: 18
window.justify: center
window.label: (%n)
window.font: sans-serif:size=9

! Focused titlebar: dark bg, rose text
window.foreground: #ebbcba
window.background: #191724
window.title.focus: #191724
window.title.unfocus: #1f1d2e
window.label.focus: #ebbcba
window.label.unfocus: #6e6a86
window.handle.focus: #191724
window.handle.unfocus: #1f1d2e

! Strong dark borders (rose-pine base on near-black)
border.width: 1
border.color: #0f0e17
border.color.focus: #403d52
