! Fluxbox style for the REAPER session (rose-pine moon).
! NOTE: key names matter — Fluxbox silently ignores unknown keys.
! Window border keys are window.borderWidth/window.borderColor (there is no
! per-focus border color); the titlebar font key is window.font.

window.font: Inter Variable:size=9
window.justify: center
window.title.height: 18

! Titlebar: dark bg, rose text when focused
window.title.focus: #191724
window.title.unfocus: #1f1d2e
window.label.focus: #ebbcba
window.label.unfocus: #6e6a86
window.handle.focus: #191724
window.handle.unfocus: #1f1d2e

! Single dark border for all windows (no focus variant exists)
window.borderWidth: 1
window.borderColor: #403d52
