[app] (name=fbrun)
  [Position]	(WINCENTER)	{0 0}
  [Layer]	{2}
[end]
# Center all REAPER windows (main + floating FX/plugin dialogs) on open.
# (Fluxbox has no "center" windowPlacement strategy, so this apps-file rule
# does it per window. WM_CLASS for both is "REAPER", verified via xwininfo.)
[app] (class=REAPER)
  [Position]	(WINCENTER)	{0 0}
[end]
