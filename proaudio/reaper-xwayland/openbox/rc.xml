<?xml version="1.0" encoding="UTF-8" ?>
<!-- Openbox config for the REAPER-on-Xwayland session.
     Managed by Home Manager (nixconfig proaudio/reaper-xwayland).
     Deliberately minimal:
       - No Alt+mouse bindings anywhere (Alt+click is REAPER's own modifier).
         Move via titlebar drag, resize via window edges.
       - No Alt+Tab (Umbriel owns it on the host).
       - New windows open centered (placement center=yes).
       - Single workspace. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Reaper</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <fontplace>Center</fontplace>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>reaper</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <focusLastOnDesktop>no</focusLastOnDesktop>
    <underMouse>no</underMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Active</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>
  <window>
    <decor>yes</decor>
    <shade>no</shade>
    <maximized>no</maximized>
  </window>
  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>400</doubleClickTime>
    <!-- Titlebar: drag to move, double-click to toggle maximize -->
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
    </context>
    <!-- Window edges: drag to resize (no modifier) -->
    <context name="Top">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>top</edge></action>
      </mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>bottom</edge></action>
      </mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>left</edge></action>
      </mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag">
        <action name="Resize"><edge>right</edge></action>
      </mousebind>
    </context>
    <context name="TRCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="TLCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="BRCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="BLCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <!-- Titlebar buttons: press focuses, click acts (these bindings ARE the
         buttons' behavior — without them the buttons are dead chrome) -->
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Close" />
      </mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Iconify" />
      </mousebind>
    </context>
  </mouse>
  <keyboard>
    <!-- Alt+F4 to close; everything else belongs to Umbriel/REAPER -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
  </keyboard>
  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
  </menu>
  <!-- REAPER positions its own windows at top-left (USPosition); force them
       centered instead. Class verified via xwininfo ("REAPER" "REAPER").
       The main window opens maximized (WM-maximized, NOT fullscreen — REAPER's
       own fullscreen bypasses the WM and breaks under Xwayland). -->
  <applications>
    <!-- All REAPER windows: center them, WITHOUT force. Non-forced position
         applies only when the program doesn't specify one itself, so
         REAPER-remembered positions are honored and only genuinely new
         windows land centered. Class verified via xwininfo
         ("REAPER" "REAPER"). -->
    <application class="REAPER">
      <position>
        <x>center</x>
        <y>center</y>
      </position>
      <focus>yes</focus>
    </application>
    <!-- Main window only (NOT floating dialogs): open WM-maximized. Matched
         by title ("<project> - REAPER v7.80 ..."). This is WM-maximized, NOT
         fullscreen — REAPER's own fullscreen bypasses the WM and breaks
         under Xwayland. -->
    <application class="REAPER" title="* - REAPER v*">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
